OPENAI_API_KEY=sk-your-key-here
ANTHROPIC_API_KEY=sk-ant-your-key-here

# 可选：中转站 / 第三方 API 代理地址（留空 = 官方默认）
# 管理员可信配置：Base URL 与同一 provider 的环境 Key 成对使用。
# UI 自定义 Base URL 不会借用这里的环境 Key。
# OPENAI_BASE_URL=https://api.openai.com/v1
# ANTHROPIC_BASE_URL=https://api.anthropic.com

# 可选：覆盖 Vision 模型（默认 claude-sonnet-5 / gpt-4o）
# ANTHROPIC_VISION_MODEL=claude-sonnet-5
# OPENAI_VISION_MODEL=gpt-4o

# 历史记录默认关闭。仅可信单用户部署可显式启用；多人/公开部署必须保持 disabled。
# 现有 history.db 不会被删除；启用后仍可读取旧记录。
CROCHET_HISTORY_MODE=disabled
# CROCHET_HISTORY_MODE=single_user
# CROCHET_HISTORY_DB=/absolute/private/path/history.db
